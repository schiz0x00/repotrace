generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth core tables ────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ── Application tables ─────────────────────────────────────────────────────

enum ProjectProvider {
  github
  gitlab
  bitbucket
  generic
}

enum ProjectStatus {
  created
  syncing
  synced
  error
}

enum FileStatus {
  indexed
  failed
  removed
}

enum ChunkType {
  code
  documentation
  configuration
  test
  other
}

enum ChunkStatus {
  pending
  embedded
  failed
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum JobType {
  initial_index
  incremental_index
  full_reindex
  reembed
  repository_sync
  delete_project
}

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  provider    ProjectProvider
  repoUrl     String
  defaultBranch String         @default("main")
  status      ProjectStatus   @default(created)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Embedding configuration (per project/index). Empty means "use system
  // defaults from environment".
  embeddingProvider String?
  embeddingApiUrl   String?
  embeddingApiKeyEnc String?
  embeddingModel    String?
  embeddingDimensions Int?
  embeddingBatchSize Int?
  embeddingVersion  Int? // increments when the model changes; never mixed in one collection

  repository Repository?
  files     File[]
  symbols   Symbol[]
  chunks    Chunk[]
  jobs      Job[]
  apiKeys   ApiKey[]
  evalQuestions EvalQuestion[]

  @@map("project")
}

model Repository {
  id                  String          @id @default(cuid())
  projectId           String          @unique
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider            ProjectProvider
  url                 String
  branch              String
  credentialsEncrypted String? // AES-256-GCM encrypted, never plaintext
  lastKnownCommit     String?
  lastSuccessfulSync  DateTime?
  syncStatus          ProjectStatus   @default(created)
  syncError           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  files   File[]
  commits Commit[]

  @@map("repository")
}

model File {
  id               String     @id @default(cuid())
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId     String
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  path             String
  language         String
  hash             String
  size             Int
  status           FileStatus @default(indexed)
  error            String?
  lastIndexedCommit String?
  lastIndexedAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  symbols Symbol[]
  chunks  Chunk[]

  @@unique([repositoryId, path])
  @@index([projectId])
  // Backs GET /files, which pages one project ordered by path. The index above
  // covers the filter but not the sort.
  @@index([projectId, path])
  @@map("file")
}

model Symbol {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId        String
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  name          String
  qualifiedName String
  kind          String // function | method | class | interface | type | enum | module | route | constant | test | ...
  language      String
  startLine     Int
  endLine       Int
  parentName    String?
  metadata      Json? // { calls: string[], imports: string[], implements: string[], extends: string[], doc: string? }
  // Generated tsvector column added by migration 20260920000000_lexical_search.
  // See the note on Chunk.contentTsv: the companion GIN index
  // "symbol_name_tsv_idx" cannot be expressed in the Prisma schema either.
  nameTsv       Unsupported("tsvector")?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chunks Chunk[]

  @@index([projectId, qualifiedName])
  @@index([projectId, name])
  @@index([fileId])
  // NOTE: migration 20260920000000_lexical_search also creates
  // "symbol_qualified_name_prefix_idx" ON "symbol" ("qualifiedName" text_pattern_ops).
  // Prisma cannot express text_pattern_ops without the `extendedIndexes` preview
  // feature, so it is intentionally absent here. `prisma migrate deploy` (the
  // production path) only applies pending migrations and never drops anything,
  // but `prisma migrate dev` would generate a DROP for it — re-create the index
  // from the migration if you regenerate migrations.
  @@map("symbol")
}

model Chunk {
  id               String     @id @default(cuid())
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId           String
  file             File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  symbolId         String?
  symbol           Symbol?    @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  content          String
  contentHash      String
  chunkType        ChunkType
  startLine        Int
  endLine          Int
  embeddingModel   String?
  embeddingVersion Int?
  status           ChunkStatus @default(pending)
  error            String?
  // Generated tsvector column added by migration 20260920000000_lexical_search.
  // Declared here so `prisma migrate dev` does not try to drop the column.
  //
  // That same migration also creates "chunk_content_tsv_idx", a GIN index on
  // this column. Prisma cannot express a GIN index (or text_pattern_ops) in
  // the schema, so it is invisible here in both directions: `prisma migrate
  // deploy` -- the production path -- only applies pending migrations and never
  // drops anything, so the index survives. But `prisma migrate dev` diffs the
  // schema against the live database and WILL generate a DROP INDEX for it,
  // because the index exists in the database but not in the schema. If you
  // regenerate migrations, re-create both indexes from the migration file.
  contentTsv       Unsupported("tsvector")?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([fileId, contentHash, startLine])
  @@index([projectId])
  // Foreign key with ON DELETE CASCADE. Without this, deleting a file's
  // symbols made Postgres sequentially scan the whole chunk table to find the
  // rows to cascade — the dominant cost of re-indexing a single file.
  @@index([symbolId])
  @@map("chunk")
}

model Commit {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sha          String
  message      String
  author       String
  authoredAt   DateTime

  @@unique([repositoryId, sha])
  // Backs the commit history listing — GET /api/v1/projects/:idOrSlug/commits
  // and the MCP `list_commits` tool both read one repository with
  // `WHERE repositoryId = $1 [AND <keyset cursor>] ORDER BY authoredAt DESC,
  // sha DESC LIMIT n`. The unique index above filters on repositoryId and
  // orders by sha within that repository, but authoredAt is not in it at all,
  // so it cannot supply the order: every page — including the first — sorted
  // the repository's entire recorded history before the top `n` were taken.
  // The history is uncapped by design (recordTipCommit in the indexing
  // pipeline), so that sort is not small.
  //
  // ASC is what the index stores, deliberately. A backward scan of this btree
  // yields exactly (authoredAt DESC, sha DESC), so no DESC column order is
  // needed — and the same index also serves the ASC reading.
  //
  // Created by migration 20260929000000_commits_index.
  @@index([repositoryId, authoredAt, sha])
  @@map("commit")
}

model Job {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        JobType
  status      JobStatus @default(queued)
  progress    Int       @default(0)
  stage       String?
  error       String?
  metadata    Json?
  attempts    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, createdAt])
  // The dashboard and the orphan reaper filter by status alone
  // (`status = 'queued'`, `status IN ('queued','running')`). The index above
  // leads with projectId and is unusable for those queries.
  @@index([status, createdAt])
  @@map("job")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_key")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  provider     String
  deliveryId   String?
  projectId    String?
  event        String?
  status       String // received | processed | ignored | failed
  error        String?
  createdAt    DateTime @default(now())

  @@unique([provider, deliveryId])
  @@index([projectId, createdAt])
  @@map("webhook_delivery")
}

model MetricEvent {
  id        String   @id @default(cuid())
  name      String // embedding_latency_ms | qdrant_latency_ms | search_latency_ms | indexing_duration_ms | embedding_failures | job_failures | queue_depth | ...
  projectId String?
  value     Float
  recordedAt DateTime @default(now())

  @@index([name, recordedAt])
  @@index([projectId, recordedAt])
  // pruneMetrics deletes rows older than a cutoff with no other predicate, and
  // the hourly retention sweep runs it against the whole table. Neither index
  // above leads with recordedAt.
  @@index([recordedAt])
  @@map("metric_event")
}

model EvalQuestion {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question      String
  expectedFiles String[] // paths expected in the result set
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@map("eval_question")
}