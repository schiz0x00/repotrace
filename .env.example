# ── Infrastructure ──────────────────────────────────────────────────────────
# PostgreSQL connection string. The password must match POSTGRES_PASSWORD below.
DATABASE_URL="postgresql://repotrace:repotrace@localhost:5432/repotrace"
# Redis connection string (job queue). docker-compose.yml starts redis-server
# with --requirepass, so the password is mandatory: a bare redis://localhost:6379
# is refused by the server.
REDIS_URL="redis://:repotrace-redis@localhost:6379"
# Qdrant REST endpoint + API key.
# docker-compose.yml starts Qdrant WITH an API key; set the same value here, or
# the client is refused. Leave empty only if you run Qdrant without auth.
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="repotrace-qdrant"

# ── docker compose infrastructure credentials ───────────────────────────────
# Used by docker-compose.yml to configure the backing services. Compose does NOT
# read this file: it resolves ${VAR} / ${VAR:-default} from your shell and from
# the project `.env` file, which is what `cp .env.example .env` (step 1 of the
# quickstart) creates. With `.env` absent, compose falls back to the `:-`
# defaults baked into docker-compose.yml, which are the values below — so
# `docker compose up` works as-is; change them before exposing any port beyond
# localhost.
POSTGRES_PASSWORD="repotrace"
REDIS_PASSWORD="repotrace-redis"
# QDRANT_API_KEY above is shared with compose.
#
# All three services publish on 127.0.0.1 only. Change these credentials before
# moving any port off loopback.

# ── Authentication (Better Auth) ───────────────────────────────────────────
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Public URL of the app
BETTER_AUTH_URL="http://localhost:3000"
# Use secure (SameSite=None/HTTPS) cookies behind a TLS proxy
USE_SECURE_COOKIES="false"

# ── Embedding provider (OpenAI-compatible) ─────────────────────────────────
# System-wide defaults; can be overridden per project in the dashboard.
# EMBEDDING_DIMENSIONS must match the model, and must also match the width the
# mock server is started with: `npm run mock-embeddings -- 11435 768`.
# The app posts to ${EMBEDDING_API_URL}/embeddings. Ollama and friends mount that
# route under /v1; the bundled mock serves it at its root, so use
# EMBEDDING_API_URL="http://localhost:11435" (no /v1) when running the mock.
EMBEDDING_PROVIDER="openai-compatible"
EMBEDDING_API_URL="http://localhost:11434/v1"   # e.g. Ollama, LM Studio, vLLM, or an OpenAI-compatible gateway
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="nomic-embed-text"              # small 1-3B class models expected
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VERSION=1
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_MAX_RETRIES=3

# ── GitHub ─────────────────────────────────────────────────────────────────
# Secret used to verify GitHub webhook signatures (GitHub -> repo webhook settings)
GITHUB_WEBHOOK_SECRET=""

# ── Repository workspaces ──────────────────────────────────────────────────
WORKSPACE_DIR="data/workspaces"
# Delete stale cloned workspaces after N days (0 disables cleanup)
WORKSPACE_RETENTION_DAYS=7

# 32-byte base64 key used to encrypt repository credentials at rest.
# Generate with: openssl rand -base64 32
REPO_CREDENTIALS_KEY="replace-with-openssl-rand-base64-32"

# ── SMTP (password reset emails) ───────────────────────────────────────────
# SMTP_HOST is the switch, and the only one: an empty value means this server
# has no mail transport, and the auth route then answers every password-reset
# request with 503 before any mail is attempted. The console branch in
# src/lib/mailer.ts (print to stdout outside production, throw in production)
# exists for direct callers and tests, but no HTTP request reaches it. The
# That NODE_ENV switch is set by `next start` and by `next dev`, not by tsx;
# it is deliberately not pinned here.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="repotrace@localhost"

# ── Workers ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=5000

MAX_FILE_SIZE_BYTES=1000000

# ── Observability ───────────────────────────────────────────────────────────
# Metric events are append-only; the worker prunes rows older than this.
METRIC_RETENTION_DAYS=30